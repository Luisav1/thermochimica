   RowBox[{"q", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"u", " ", 
       SuperscriptBox["xi", 
        RowBox[{"u", "-", "1"}]]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "u", "-", "v", "-", "w"}], ")"}], 
       SuperscriptBox["xi", "u"]}]}], ")"}], 
    SuperscriptBox["xj", "v"], 
    SuperscriptBox["xk", "w"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8062320923650017`*^9, 3.806232120427553*^9}, {
