           RowBox[{"x", "[", "i", "]"}], 
           RowBox[{"x", "[", "k", "]"}]}]}], ")"}], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lik", "[", "v", "]"}], 
