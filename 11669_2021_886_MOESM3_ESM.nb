Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"q", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"n", "[", "1", "]"}], 
       RowBox[{
        RowBox[{"n", "[", "1", "]"}], "+", 
        RowBox[{"n", "[", "2", "]"}], "+", 
        RowBox[{"n", "[", "3", "]"}], "+", 
        RowBox[{"n", "[", "4", "]"}], "+", 
        RowBox[{"n", "[", "5", "]"}]}]], ")"}], "u"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"n", "[", "2", "]"}], 
       RowBox[{
        RowBox[{"n", "[", "1", "]"}], "+", 
        RowBox[{"n", "[", "2", "]"}], "+", 
        RowBox[{"n", "[", "3", "]"}], "+", 
        RowBox[{"n", "[", "4", "]"}], "+", 
        RowBox[{"n", "[", "5", "]"}]}]], ")"}], "v"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"n", "[", "3", "]"}], 
       RowBox[{
        RowBox[{"n", "[", "1", "]"}], "+", 
        RowBox[{"n", "[", "2", "]"}], "+", 
        RowBox[{"n", "[", "3", "]"}], "+", 
        RowBox[{"n", "[", "4", "]"}], "+", 
        RowBox[{"n", "[", "5", "]"}]}]], ")"}], "w"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "v", "+", "w"}], ")"}], " ", 
       RowBox[{"n", "[", "1", "]"}]}], "-", 
      RowBox[{"u", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"n", "[", "2", "]"}], "+", 
         RowBox[{"n", "[", "3", "]"}], "+", 
         RowBox[{"n", "[", "4", "]"}], "+", 
         RowBox[{"n", "[", "5", "]"}]}], ")"}]}]}], ")"}]}], 
   RowBox[{"n", "[", "1", "]"}]]}]], "Output",
 CellChangeTimes->{3.806142224762493*^9, 3.806142463419199*^9, 
