           RowBox[{"{", 
            RowBox[{"v", ",", "1", ",", "nv"}], "}"}]}], "]"}]}]}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nSpecies"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "i", ",", "nSpecies"}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
