}, Open  ]],

Cell["\<\
On above line simply insert +u n[1] - u n[1] in last parenthesis group to get \
eq 15 from paper.\
\>", "Text",
 CellChangeTimes->{{3.806081116459502*^9, 3.806081169100206*^9}, {
  3.8062320680368166`*^9, 
  3.806232080318101*^9}},ExpressionUUID->"ef91be4c-007d-4050-8362-\
2b1eb7588bc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Mu]SPmanuscript", " ", "=", "  ", 
   RowBox[{"q", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"u", " ", 
        SuperscriptBox[
         RowBox[{"n", "[", "1", "]"}], 
         RowBox[{"u", "-", "1"}]], 
        SuperscriptBox[
         RowBox[{"n", "[", "2", "]"}], "v"], 
        SuperscriptBox[
         RowBox[{"n", "[", "3", "]"}], "w"]}], 
       SuperscriptBox[
        RowBox[{"nt", " "}], 
        RowBox[{"u", "+", "v", "+", "w", "-", "1"}]]], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u", "+", "v", "+", "w", "-", "1"}], ")"}], 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"n", "[", "1", "]"}], "u"], 
         SuperscriptBox[
          RowBox[{"n", "[", "2", "]"}], "v"], 
         SuperscriptBox[
          RowBox[{"n", "[", "3", "]"}], "w"]}], 
        SuperscriptBox[
         RowBox[{"nt", " "}], 
         RowBox[{"u", "+", "v", "+", "w"}]]]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8062320923650017`*^9, 3.806232120427553*^9}},
 CellLabel->
  "In[339]:=",ExpressionUUID->"03500752-b2aa-4770-8802-b05005604d96"],

Cell[BoxData[
 RowBox[{
