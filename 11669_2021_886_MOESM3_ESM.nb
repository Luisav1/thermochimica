Cell[BoxData[
 RowBox[{
  RowBox[{"GRKMPbin", "[", "k_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"n", "[", "k", "]"}], 
        RowBox[{"n", "[", "j", "]"}]}], "nt"], 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Lkj", "[", "v", "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             RowBox[{"n", "[", "k", "]"}], "-", 
             RowBox[{"n", "[", "j", "]"}]}], "nt"], ")"}], "v"]}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "1", ",", "nv"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"k", "+", "1"}], ",", "nSpecies"}], "}"}]}], "]"}], "+", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"n", "[", "i", "]"}], 
        RowBox[{"n", "[", "k", "]"}]}], "nt"], 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Lik", "[", "v", "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             RowBox[{"n", "[", "i", "]"}], "-", 
             RowBox[{"n", "[", "k", "]"}]}], "nt"], ")"}], "v"]}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "1", ",", "nv"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], "+", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"i", "\[Equal]", "k"}], "||", 
        RowBox[{"j", "\[Equal]", "k"}]}], ",", "0", ",", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"n", "[", "i", "]"}], 
          RowBox[{"n", "[", "j", "]"}]}], "nt"], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lij", "[", "v", "]"}], 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{
               RowBox[{"n", "[", "i", "]"}], "-", 
               RowBox[{"n", "[", "j", "]"}]}], "nt"], ")"}], "v"]}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "1", ",", "nv"}], "}"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nSpecies"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "i", ",", "nSpecies"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8062308166282606`*^9, 3.8062308270345488`*^9}, {
   3.8062308571752357`*^9, 3.806231063222468*^9}, {3.8062310939569044`*^9, 
   3.806231096925645*^9}, 3.8062315421608562`*^9, {3.8062318125363464`*^9, 
