      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"k", "+", "1"}], ",", "nSpecies"}], "}"}]}], "]"}], "+", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "[", "i", "]"}], "-", 
