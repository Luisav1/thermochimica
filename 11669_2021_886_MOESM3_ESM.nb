       RowBox[{
        RowBox[{"x", "[", "i", "]"}], 
        RowBox[{"x", "[", "k", "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "[", "i", "]"}], "-", 
            RowBox[{"x", "[", "k", "]"}]}], ")"}]}], ")"}], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lik", "[", "v", "]"}], "v", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", "i", "]"}], "-", 
              RowBox[{"x", "[", "k", "]"}]}], ")"}], 
            RowBox[{"v", "-", "1"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "1", ",", "nv"}], "}"}]}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], "-", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"i", "\[Equal]", "k"}], "||", 
         RowBox[{"j", "\[Equal]", "k"}]}], ",", "0", ",", " ", 
        RowBox[{
         RowBox[{"x", "[", "i", "]"}], 
         RowBox[{"x", "[", "j", "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Lij", "[", "v", "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "+", "v"}], ")"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"x", "[", "i", "]"}], "-", 
