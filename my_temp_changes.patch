+   "source": [
+    "# --- numeric finite-difference check (central differences) ---\n",
+    "# lambdify functions for numeric evaluation\n",
+    "fG = sp.lambdify((nA, nB, L0), G, 'numpy')\n",
+    "fG_AA_sym = sp.lambdify((nA, nB, L0), G_AA, 'numpy')\n",
+    "fG_BB_sym = sp.lambdify((nA, nB, L0), G_BB, 'numpy')\n",
+    "fG_AB_sym = sp.lambdify((nA, nB, L0), G_AB, 'numpy')\n",
+    "\n",
+    "def finite_diff_second(f, a, b, L0val, h=1e-6):\n",
+    "    # compute mixed and pure second derivatives of f(nA,nB)\n",
+    "    f00 = f(a, b, L0val)\n",
+    "    f_pp = f(a+h, b+h, L0val)\n",
+    "    f_pm = f(a+h, b-h, L0val)\n",
+    "    f_mp = f(a-h, b+h, L0val)\n",
+    "    f_mm = f(a-h, b-h, L0val)\n",
+    "    # central second derivatives:\n",
+    "    G_AA_fd = (f(a+h, b, L0val) - 2*f00 + f(a-h, b, L0val)) / (h*h)\n",
+    "    G_BB_fd = (f(a, b+h, L0val) - 2*f00 + f(a, b-h, L0val)) / (h*h)\n",
+    "    G_AB_fd = (f_pp - f_pm - f_mp + f_mm) / (4*h*h)\n",
+    "    return G_AA_fd, G_BB_fd, G_AB_fd\n",
+    "\n",
+    "# choose a reasonable test point (avoid zeros)\n",
+    "a = 2.0   # nA\n",
+    "b = 1.5   # nB\n",
+    "L0val = 5000.0\n",
+    "\n",
+    "G_AA_fd, G_BB_fd, G_AB_fd = finite_diff_second(fG, a, b, L0val, h=1e-6)\n",
+    "\n",
+    "# Evaluate symbolic expressions numerically\n",
+    "G_AA_sym = fG_AA_sym(a, b, L0val)\n",
+    "G_BB_sym = fG_BB_sym(a, b, L0val)\n",
+    "G_AB_sym = fG_AB_sym(a, b, L0val)\n",
+    "\n",
+    "print(\"Numeric finite-diff G_AA:\", G_AA_fd, \"Symbolic G_AA:\", G_AA_sym)\n",
+    "print(\"Numeric finite-diff G_BB:\", G_BB_fd, \"Symbolic G_BB:\", G_BB_sym)\n",
+    "print(\"Numeric finite-diff G_AB:\", G_AB_fd, \"Symbolic G_AB:\", G_AB_sym)\n",
+    "\n",
+    "# relative errors\n",
+    "rel_err = lambda sym, fd: abs((sym - fd) / (sym if sym!=0 else 1.0))\n",
+    "print(\"rel err G_AA:\", rel_err(G_AA_sym, G_AA_fd))\n",
+    "print(\"rel err G_BB:\", rel_err(G_BB_sym, G_BB_fd))\n",
+    "print(\"rel err G_AB:\", rel_err(G_AB_sym, G_AB_fd))\n"
+   ]
