+subroutine GetOutputChemPotDerivative(cElementName1Request, cElementName2Request, dElementChemPotDerivative, INFO)
+
+    USE ModuleThermo
+    USE ModuleThermoIO
+
+    implicit none
+
+    integer,      intent(out)   :: INFO
+    integer                     :: i, j1, j2
+    real(8),      intent(out)   :: dElementChemPotDerivative
+    character(*), intent(in)    :: cElementName1Request, cElementName2Request
+    character(3)                :: cElementName1Use, cElementName2Use
+
+
+    ! Initialize variables:
+    INFO            = 0
+    dElementChemPotDerivative = 0D0
+
+    ! Only proceed if Thermochimica solved successfully:
+    if (INFOThermo == 0) then
+
+        ! Remove trailing blanks:
+        cElementName1Use = cElementName1Request
+        cElementName1Use = TRIM(cElementName1Use)
+        cElementName2Use = cElementName2Request
+        cElementName2Use = TRIM(cElementName2Use)
+
+        ! Loop through elements to find the one corresponding to the element
+        ! being requested:
+        j1 = 0
+        j2 = 0
+        ! Find element 1
+        LOOP_A: do i = 1, nElements
+            if (cElementName1Use == cElementName(i)) then 
+                j1 = i
+                exit LOOP_A
+            end if
+        end do LOOP_A
+        ! Find element 2
+        do i = 1, nElements
+            if (cElementName2Use == cElementName(i)) then
+                j2 = i
+                exit
+            end if
+        end do
+
+        ! Check both were found
+        if (j1 == 0 .or. j2 == 0) then
+            INFO = 1       ! element not found, report an error
+            return
+        else
+            ! insert derivative logic here. dummy placeholder for now
+            dElementChemPotDerivative = (dElementPotential(j1) - dElementPotential(j2)) * dIdealConstant * dTemperature
+        end if
+
+    else
+        ! Record an error with INFO if INFOThermo /= 0.
+        INFO = -1
+    end if
+
+    return
+
+end subroutine GetOutputChemPotDerivative
