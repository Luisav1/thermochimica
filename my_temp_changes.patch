+   "source": [
+    "import sympy as sp\n",
+    "\n",
+    "# Symbols\n",
+    "nA, nB, L0 = sp.symbols('n_A n_B L_0', positive=True)\n",
+    "\n",
+    "# Total moles and mole fractions\n",
+    "n = nA + nB\n",
+    "xA = nA / n\n",
+    "xB = nB / n\n",
+    "\n",
+    "# Excess Gibbs energy for v = 0\n",
+    "# G_ex = n * xA * xB * L0\n",
+    "# Equivalent form:\n",
+    "G = (nA * nB / n) * L0\n",
+    "\n",
+    "# first partial derivatives (chemical potentials)\n",
+    "muA = sp.simplify(sp.diff(G, nA))\n",
+    "muB = sp.simplify(sp.diff(G, nB))\n",
+    "\n",
+    "# second derivatives (Hessian)\n",
+    "G_AA = sp.simplify(sp.diff(muA, nA))\n",
+    "G_BB = sp.simplify(sp.diff(muB, nB))\n",
+    "G_AB = sp.simplify(sp.diff(muA, nB))  # = G_BA\n",
+    "\n",
+    "# show results\n",
+    "sp.pretty_print(muA)\n",
+    "sp.pretty_print(muB)\n",
+    "sp.pretty_print(G_AA)\n",
+    "sp.pretty_print(G_BB)\n",
+    "sp.pretty_print(G_AB)"
