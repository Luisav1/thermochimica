+    "# --- check 1: mixed derivative symmetry ---\n",
+    "symmetry_ok = sp.simplify(G_AB - sp.diff(muB, nA)) == 0\n",
+    "print(\"Mixed derivative symmetry OK?\", symmetry_ok)"
+   ]
+  },
